{
  "openapi": "3.1.0",
  "info": {
    "title": "体积重量计算器",
    "description": "输入包裹尺寸（长、宽、高，厘米），除以 5000 计算计费重量（公斤）。同时提供一个 JSON API。",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["system"],
        "summary": "Health",
        "description": "Substrait calls this to decide whether the app started correctly.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "ok" } },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/api/volumetric-weight": {
      "get": {
        "tags": ["calculator"],
        "summary": "Volumetric weight",
        "description": "Calculate volumetric (billable) weight from package dimensions. Formula: (length × width × height) ÷ 5000.",
        "operationId": "volumetric_weight_api_volumetric_weight_get",
        "parameters": [
          {
            "name": "length",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "minimum": 0 },
            "description": "Package length in centimeters"
          },
          {
            "name": "width",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "minimum": 0 },
            "description": "Package width in centimeters"
          },
          {
            "name": "height",
            "in": "query",
            "required": true,
            "schema": { "type": "number", "minimum": 0 },
            "description": "Package height in centimeters"
          }
        ],
        "responses": {
          "200": {
            "description": "Volumetric weight calculation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "length_cm": { "type": "number", "example": 30 },
                    "width_cm": { "type": "number", "example": 20 },
                    "height_cm": { "type": "number", "example": 15 },
                    "divisor": { "type": "integer", "example": 5000 },
                    "volumetric_weight_kg": { "type": "number", "example": 1.8 }
                  },
                  "required": ["length_cm", "width_cm", "height_cm", "divisor", "volumetric_weight_kg"]
                }
              }
            }
          },
          "422": {
            "description": "Validation error — a required parameter is missing or below zero"
          }
        }
      }
    }
  }
}
